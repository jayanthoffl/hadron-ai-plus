# ==============================================================================
# HADRON AI++ — Environment Configuration
# ==============================================================================

# ServiceNow Instance Configuration
SERVICENOW_INSTANCE_URL=https://devXXXXXX.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your_instance_password

# Machine Integration User (for automated flow trigger testing)
# Username: hadron.integration
# sys_id: 8726ef7483ef8f101fdfc829feaad303

# Google Gemini API Keys (Multi-Key Pool for High-Concurrency & Quota Failover)
# Supply multiple keys separated by commas, spaces, or newlines for zero-downtime key rotation
GEMINI_API_KEYS=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...,AIzaSyKey4...
# Fallback single key (if GEMINI_API_KEYS not set):
# GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Service Networking & Ports
HADRON_ENV=production
HADRON_PORT=5000
HADRON_API_URL=http://127.0.0.1:5000
HADRON_API_TIMEOUT=120
